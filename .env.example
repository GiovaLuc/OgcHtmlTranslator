PORT=3001
OUT_DIR=./out

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=30000
# Lista di modelli accettabili per il parametro "model" di POST /translate, separati
# da virgola. Se assente, usa i tre di default qui sotto.
OLLAMA_ALLOWED_MODELS=starcoder2:instruct,fl0id/teuken-7b-instruct-commercial-v0.4:latest,qwen2.5-coder:1.5b

# URL esterna a cui viene inviato (POST) il risultato di ogni job una volta pronto.
# Se assente, il risultato resta disponibile solo via file locale / GET /translate/:translationId.
CALLBACK_URL=
CALLBACK_TIMEOUT_MS=10000


# Rete: il translator accetta solo richieste da loopback e reti private (10/8, 172.16/12,
# 192.168/16, link-local, IPv6 ULA). Per restringere o allargare, elenco CIDR separato da virgole.
# Si basa sull'IP del socket, non su X-Forwarded-For.
ALLOWED_NETWORKS=
